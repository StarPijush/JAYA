# JARVIS Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=true

# Future LLM Configuration (leave empty for now)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.7

# Voice Recognition (Phase 1)
# Model size: tiny, base, small, medium, large-v3, turbo, distil-* (also .en variants)
VOICE_MODEL_SIZE=base
# Spoken language code, e.g. en, es, fr, de
VOICE_LANGUAGE=en
# Inference device: cpu, cuda, or auto
VOICE_DEVICE=cpu
# CTranslate2 compute type. int8 is fastest on CPU; float16 suits CUDA.
VOICE_COMPUTE_TYPE=int8
# Recording length in seconds
VOICE_RECORD_SECONDS=5
# Microphone device index. Leave unset to use the system default input device.
# Run: uv run python -m core.voice --list-devices
# VOICE_MICROPHONE_DEVICE=1
# Optional override for the downloaded model cache directory.
# Defaults to %LOCALAPPDATA%\JARVIS\models\whisper
# VOICE_MODEL_PATH=C:\Users\you\.cache\jarvis\whisper

# Audio is always resampled to 16000 Hz before transcription. That rate is fixed by
# the Whisper feature extractor and is intentionally not configurable. The capture
# rate is negotiated per microphone automatically.

# Future Voice Configuration
# WAKE_WORD=jarvis
# STT_MODEL=whisper-base
# TTS_VOICE=en-US-AriaNeural